{
  "id": "./",
  "name": "StudBud | Plan, Study, Play",
  "short_name": "StudBud",
  "description": "A student hub for classes, assignments, grades and flashcards, with live multiplayer games powered by your own study sets.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#111827",
  "theme_color": "#111827",
  "icons": [
    { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "./icons/studbud.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Study streak", "short_name": "Streak", "description": "See your streak and the study leaderboard", "url": "./#/leaderboard", "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Assignments", "short_name": "Planner", "description": "Open your assignment planner", "url": "./#/planner", "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Flashcards", "short_name": "Cards", "description": "Review flashcards that are due", "url": "./#/flashcard", "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "widgets": [
    {
      "name": "StudBud streak",
      "short_name": "Streak",
      "description": "Your study streak, today's goal, assignments to work on, grades and flashcards due.",
      "tag": "studbud-streak",
      "ms_ac_template": "./widgets/streak-template.json",
      "data": "./widgets/streak-data.json",
      "type": "application/json",
      "auth": false,
      "update": 900,
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }],
      "screenshots": [{ "src": "./icons/icon-512.png", "sizes": "512x512", "label": "StudBud streak widget" }]
    }
  ]
}
